# Every field of src/diacritics/config/settings.py can be overridden by an env var.
# CLI flags override env. Values below are the defaults.

# Logging: auto (colors + live progress bar on a terminal, JSON lines when piped), pretty, json
DIACRITICS_LOG_FORMAT=auto

# Paths
DIACRITICS_DATA_DIR=data
DIACRITICS_ARTIFACTS_DIR=artifacts
DIACRITICS_CORRECTIONS_DIR=corrections

# Corpus
DIACRITICS_MIN_DOC_CHARS=200
DIACRITICS_MIN_DIACRITIC_RATIO=0.05
DIACRITICS_MAX_DOCUMENTS=0
DIACRITICS_VALID_EVERY=50

# Model
DIACRITICS_VOCAB_SIZE=256
DIACRITICS_WINDOW=256
DIACRITICS_OVERLAP=32
DIACRITICS_D_MODEL=192
DIACRITICS_N_LAYERS=4
DIACRITICS_N_HEADS=4
DIACRITICS_D_FF=512
DIACRITICS_DROPOUT=0.1

# Training
DIACRITICS_BATCH_SIZE=256
DIACRITICS_LR=0.0003
DIACRITICS_WARMUP_STEPS=1000
DIACRITICS_MAX_STEPS=30000
DIACRITICS_EVAL_EVERY=1000
DIACRITICS_CHECKPOINT_EVERY=1000
DIACRITICS_SEED=42
DIACRITICS_DEVICE=auto
DIACRITICS_NUM_WORKERS=2
DIACRITICS_THRESHOLD=0.5
# Times the known-mistakes shard is repeated per epoch (0 turns it off)
DIACRITICS_CORRECTIONS_REPEAT=20
