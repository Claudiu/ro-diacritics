{
  "manifest_version": 3,
  "name": "Diacritice",
  "version": "0.1.0",
  "description": "Un buton lângă câmpurile de text care pune diacriticele românești. Totul rulează local, nimic nu pleacă din browser.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Adaugă diacritice în câmpul activ (Alt+Shift+D)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://docs.google.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fix": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Adaugă diacritice în câmpul activ"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
